{
  "name": "kanbada",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "node scripts/generate-dark-theme.mjs && tsc -b && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node scripts/check-api-browser.mjs && node scripts/check-payload-browser.mjs && node scripts/check-jira-browser.mjs",
    "test:jira": "node scripts/check-jira-browser.mjs",
    "test:branding": "node scripts/check-branding-browser.mjs",
    "theme:generate": "node scripts/generate-dark-theme.mjs",
    "test:local": "node scripts/check-browser.mjs",
    "lint": "eslint src --max-warnings 0",
    "typecheck": "tsc -b",
    "format": "prettier --write src scripts vite.config.ts tsconfig.json package.json eslint.config.mjs",
    "format:check": "prettier --check src scripts vite.config.ts tsconfig.json package.json eslint.config.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check"
  },
  "dependencies": {
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "lucide-react": "^0.468.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.51.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.5.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^6.3.0"
  },
  "engines": {
    "node": ">=22.12.0"
  }
}
