DOMUS_BIND_HOST=127.0.0.1
DOMUS_PORT=8088
DOMUS_PUBLIC_URL=http://localhost:8088
DOMUS_ALLOWED_HOSTS=localhost;127.0.0.1
POSTGRES_ADMIN_PASSWORD=domus-admin-local-change-me
MEMBERSHIP_DB_PASSWORD=domus-membership-local-change-me
WORK_DB_PASSWORD=domus-work-local-change-me
AUTOMATION_DB_PASSWORD=domus-automations-local-change-me
RABBITMQ_PASSWORD=domus-rabbit-local-change-me
PLATFORM_ADMIN_EMAILS=
JIRA_ALLOWED_HOSTS=

# Personal ChatGPT subscription OAuth (local open-source flow requires 127.0.0.1).
AI_OPENAI_OAUTH_MODE=
AI_OPENAI_CLIENT_ID=
AI_OPENAI_CLIENT_SECRET=

# Dedicated AI database; model credentials continue to use personal OAuth.
AI_DB_PASSWORD=domus-ai-local-change-me

# Internal membership → boards identity delivery; use a private random value when hosting.
DOMUS_IDENTITY_SYNC_SECRET=domus-local-identity-sync-change-me
